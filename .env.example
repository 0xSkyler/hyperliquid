# Live is the only trading mode. Nothing is traded until an account is connected and Start is
# pressed in the control panel. (Developers: HL_MODE=paper runs the built-in simulator.)
HL_MODE=live
HL_COIN=BTC
HL_PAPER_EQUITY=1000
HL_HORIZON_S=60
# Preferences, not rules: CRRA risk aversion (1 = full Kelly) and the gap scenario.
HL_RISK_AVERSION=4
HL_JUMP_PROB=0.0001
HL_JUMP_SIZE=0.015
HL_LATENCY_MS=150
HL_DATA_DIR=data
HL_RECORD_RAW=0
# Model line-up; the first is the starting champion.
HL_MODELS=ridge,mlp,tree,flow,ridge_disc
# LLM news scoring: paid, off by default. Needs ANTHROPIC_API_KEY.
HL_LLM_NEWS=0
# HL_LLM_MODEL=claude-opus-5-5
# HL_LLM_MAX_PER_POLL=5
# ANTHROPIC_API_KEY=
# Chart models (chart_<timeframe>.txt) trained on historical candles (python -m app.research.chart_train).
# HL_CHART_MODEL_DIR=models
# Learned state file; default <HL_DATA_DIR>/state/engine-<coin>.pkl
# HL_STATE_PATH=
HL_DASHBOARD_HOST=127.0.0.1
HL_DASHBOARD_PORT=8787
# Comma-separated RSS/Atom feeds; empty disables news.
# HL_NEWS_FEEDS=
# Optional: write to Postgres instead of JSONL files.
# DATABASE_URL=postgresql://hl:hl@db:5432/hl

# The Hyperliquid account is connected in the control panel (http://127.0.0.1:8787), which stores
# the API wallet key in data/control.json. These are only an alternative for unattended setups:
# HL_ACCOUNT_ADDRESS=
# HL_API_SECRET_KEY=
# Cap exposure below the venue's maximum (also settable in the panel):
# HL_MAX_LEVERAGE=
